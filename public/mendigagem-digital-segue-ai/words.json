  "voice": "pt-BR-AntonioNeural",
  "rate": "+8%",
  "cues": [
    {
      "start": 0.096,
      "end": 3.198,
      "text": "Eu tô aqui todo dia fazendo vídeo de curiosidade musical..."
    },
    {
      "start": 3.499,
      "end": 7.284,
      "text": "montando cena, animando, narrando... caprichando nos detalhes."
    },
    {
      "start": 8.079,
      "end": 11.562,
      "text": "E o seguidor? Sumiu. Evaporou."
    },
    {
      "start": 12.361,
      "end": 14.502,
      "text": "Foi comprar cigarro e nunca mais voltou."
    },
    {
      "start": 15.301,
      "end": 18.449,
      "text": "Então é oficial: começamos a mendigagem digital."
    },
    {
      "start": 19.248,
      "end": 24.201,
      "text": "Aqui no canal eu também toco guitarra, baixo, violão, escaleta e gaita de boca."
    },
    {
      "start": 25.0,
      "end": 26.551,
      "text": "Eu não tô dizendo que eu sou bom..."
    },
    {
      "start": 26.794,
      "end": 28.507,
      "text": "só tô dizendo que eu toco mesmo."
    },
    {
      "start": 29.306,
      "end": 33.368,
      "text": "Se você curte rock, história de banda e som de verdade, me dá uma moral."
    },
    {
      "start": 34.167,
      "end": 37.037,
      "text": "Segue o perfil, curte, comenta e compartilha."
    }
  ],
