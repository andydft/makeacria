{
  "language": "pt-BR",
  "duration": 73.458,
  "voice": "pt-BR-AntonioNeural",
  "rate": "+8%",
  "segments": [
    {
      "start": 0.1,
      "end": 11.516,
      "text": "Chester Bennington ganhou um Grammy cantando sobre uma batalha que ele sentia que não conseguia controlar. E o mais surpreendente é que essa história está escondida em uma das músicas mais famosas do Linkin Park."
    },
    {
      "start": 11.516,
      "end": 20.775,
      "text": "Em 2000, a banda lançou Crawling, no álbum Hybrid Theory. Mas aquela música não era simplesmente sobre estar triste ou sofrer por alguém."
    },
    {
      "start": 20.775,
      "end": 31.597,
      "text": "Anos depois, Chester explicou que ela falava sobre a sensação de perder o controle de si mesmo, especialmente durante suas dificuldades com drogas e álcool. Era uma luta interna."
    },
    {
      "start": 31.597,
      "end": 40.543,
      "text": "Aquela sensação de querer mudar, mas continuar enfrentando os mesmos problemas. E Chester não tentava transformar isso em uma história de vítima."
    },
    {
      "start": 40.543,
      "end": 47.037,
      "text": "Em uma entrevista, ele explicou que a música também falava sobre assumir responsabilidade pelas próprias ações."
    },
    {
      "start": 47.037,
      "end": 55.798,
      "text": "Talvez por isso tanta gente tenha se identificado com ela. Em 2002, Crawling venceu o Grammy de Melhor Performance de Hard Rock."
    },
    {
      "start": 55.798,
      "end": 68.194,
      "text": "Chester transformou uma experiência pessoal em uma música que milhões de pessoas passaram a usar para expressar aquilo que não conseguiam colocar em palavras. E é por isso que a voz dele continua marcando tanta gente até hoje."
    }
  ],
  "cues": [
    {
      "start": 0.1,
      "end": 5.732,
      "text": "Chester Bennington ganhou um Grammy cantando sobre uma batalha que ele sentia que não conseguia controlar."
    },
    {
      "start": 5.682,
      "end": 11.516,
      "text": "E o mais surpreendente é que essa história está escondida em uma das músicas mais famosas do Linkin Park."
    },
    {
      "start": 11.516,
      "end": 16.076,
      "text": "Em 2000, a banda lançou Crawling, no álbum Hybrid Theory."
    },
    {
      "start": 16.076,
      "end": 20.775,
      "text": "Mas aquela música não era simplesmente sobre estar triste ou sofrer por alguém."
    },
    {
      "start": 20.775,
      "end": 29.641,
      "text": "Anos depois, Chester explicou que ela falava sobre a sensação de perder o controle de si mesmo, especialmente durante suas dificuldades com drogas e álcool."
    },
    {
      "start": 29.641,
      "end": 31.597,
      "text": "Era uma luta interna."
    },
    {
      "start": 31.597,
      "end": 36.77,
      "text": "Aquela sensação de querer mudar, mas continuar enfrentando os mesmos problemas."
    },
    {
      "start": 36.77,
      "end": 40.543,
      "text": "E Chester não tentava transformar isso em uma história de vítima."
    },
    {
      "start": 40.543,
      "end": 47.037,
      "text": "Em uma entrevista, ele explicou que a música também falava sobre assumir responsabilidade pelas próprias ações."
    },
    {
      "start": 47.037,
      "end": 50.798,
      "text": "Talvez por isso tanta gente tenha se identificado com ela."
    },
    {
      "start": 50.798,
      "end": 55.798,
      "text": "Em 2002, Crawling venceu o Grammy de Melhor Performance de Hard Rock."
    },
    {
      "start": 55.798,
      "end": 63.877,
      "text": "Chester transformou uma experiência pessoal em uma música que milhões de pessoas passaram a usar para expressar aquilo que não conseguiam colocar em palavras."
    },
    {
      "start": 63.877,
      "end": 68.194,
      "text": "E é por isso que a voz dele continua marcando tanta gente até hoje."
    },
    {
      "start": 68.194,
      "end": 71.458,
      "text": "Qual música do Chester mais marcou a sua vida?"
    }
  ],
